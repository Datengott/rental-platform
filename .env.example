# Copy to .env and fill in real values. Never commit .env.
# Grouped to match the modules/providers in deployment-infrastructure-and-module-schemas.md

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://rental_dev:rental_dev_password@localhost:5432/rental_platform
REDIS_URL=redis://localhost:6379

# --- Auth (Section B.1) ---
JWT_ACCESS_TOKEN_SECRET=replace_me_generate_a_long_random_string
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_SECRET=replace_me_generate_a_different_long_random_string
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# --- Object storage (Section A.3 — Cloudflare R2, chosen for zero egress fees) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rental-platform-media
R2_PUBLIC_URL_BASE=https://media.yourdomain.com

# --- Payments (Section 4 — pick ONE aggregator for MVP after sandbox comparison) ---
PAYMENT_AGGREGATOR=campay   # 'campay' | 'monetbil'
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
MONETBIL_WEBHOOK_SECRET=

# --- SMS + WhatsApp (Africa's Talking — Section A.3, Section 2 of multichannel doc) ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_WHATSAPP_NUMBER=

# --- Email (Section 2 of multichannel doc — Postmark or Resend) ---
EMAIL_PROVIDER=postmark   # 'postmark' | 'resend'
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=notifications@yourdomain.com

# --- Push notifications (Firebase Cloud Messaging) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- e-Signature (Section B.6 — confirm basic vs advanced tier with legal counsel first) ---
ESIGN_PROVIDER=internal_otp_basic   # placeholder until the tier decision is made

# --- Monitoring ---
SENTRY_DSN=
