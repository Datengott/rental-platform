// This schema is seeded with the Auth (B.1) and Property/Listings (B.2) modules fully
// modeled, matching the SQL DDL in docs/deployment-infrastructure-and-module-schemas.md
// EXACTLY (field names, types, constraints). Extend it module-by-module in the build
// order specified in CLAUDE.md — copy this pattern (add the model, add the enum if
// needed, run `npm run prisma:migrate`) rather than inventing a different structure.
//
// IMPORTANT: field names here must match the DDL in the docs verbatim. If you need to
// deviate, update the docs first — they are the source of truth, not this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// B.1 — Auth & Identity Module
// ============================================================

enum KycTier {
  unverified
  id_verified
  ownership_verified
}

enum UserRole {
  landlord
  tenant
  admin
  support_agent
}

model User {
  id               String    @id @default(uuid())
  phoneNumber      String    @unique @map("phone_number")
  fullName         String?   @map("full_name")
  locale           String    @default("fr") // 'fr' | 'en'
  idDocumentType   String?   @map("id_document_type")
  idDocumentRef    String?   @map("id_document_ref")
  idDocumentUrl    String?   @map("id_document_url")
  kycTier          KycTier   @default(unverified) @map("kyc_tier")
  kycVerifiedAt    DateTime? @map("kyc_verified_at")
  kycVerifiedBy    String?   @map("kyc_verified_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deactivatedAt    DateTime? @map("deactivated_at")

  roles            UserRoleAssignment[]
  sessions         Session[]

  @@map("users")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      UserRole
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model OtpChallenge {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number")
  otpHash     String    @map("otp_hash")
  purpose     String    // 'login' | 'signup' | 'sensitive_action'
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@map("otp_challenges")
}

model Session {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  refreshTokenHash  String    @map("refresh_token_hash")
  deviceInfo        Json?     @map("device_info")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// B.2 — Property & Listings Module
// ============================================================

model Property {
  id                     String    @id @default(uuid())
  landlordId             String    @map("landlord_id") // references users.id — NOT a Prisma relation
                                                          // across modules, per the cross-module rule in
                                                          // CLAUDE.md. Look up landlord details via the
                                                          // Auth module's service, not a Prisma join.
  name                   String?
  addressLine            String    @map("address_line")
  city                   String
  region                 String?
  latitude               Decimal?  @db.Decimal(9, 6)
  longitude              Decimal?  @db.Decimal(9, 6)
  ownershipDocUrl        String?   @map("ownership_doc_url")
  ownershipVerifiedAt    DateTime? @map("ownership_verified_at")
  ownershipVerifiedBy    String?   @map("ownership_verified_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  units Unit[]

  @@map("properties")
}

enum UnitStatus {
  draft
  vacant
  visit_requested
  reserved
  occupied
  notice_given
}

enum BillingCycle {
  monthly
  quarterly
  biannual
}

model Unit {
  id           String       @id @default(uuid())
  propertyId   String       @map("property_id")
  label        String?
  bedrooms     Int?
  bathrooms    Int?
  sizeSqm      Decimal?     @db.Decimal(8, 2) @map("size_sqm")
  rentAmount   Decimal      @db.Decimal(12, 0) @map("rent_amount")
  currency     String       @default("XAF")
  billingCycle BillingCycle @default(monthly) @map("billing_cycle")
  status       UnitStatus   @default(draft)
  description  String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  photos   UnitPhoto[]

  @@index([status])
  @@index([propertyId])
  @@map("units")
}

model UnitPhoto {
  id           String    @id @default(uuid())
  unitId       String    @map("unit_id")
  storageUrl   String    @map("storage_url")
  geoLatitude  Decimal?  @db.Decimal(9, 6) @map("geo_latitude")
  geoLongitude Decimal?  @db.Decimal(9, 6) @map("geo_longitude")
  capturedAt   DateTime? @map("captured_at")
  sortOrder    Int       @default(0) @map("sort_order")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_photos")
}

// ============================================================
// B.3 — Visit Requests Module
// ============================================================

enum VisitRequestStatus {
  pending
  accepted
  declined
  rescheduled
  expired
  completed
}

model VisitRequest {
  id             String              @id @default(uuid())
  unitId         String              @map("unit_id") // references units.id — NOT a Prisma relation
                                                        // across modules, per CLAUDE.md. Look up the unit
                                                        // via the Properties module's service.
  tenantId       String              @map("tenant_id") // references users.id — same rule.
  landlordId     String              @map("landlord_id") // denormalized for fast landlord-side queries.
  requestedSlots Json?               @map("requested_slots")
  status         VisitRequestStatus  @default(pending)
  confirmedSlot  DateTime?           @map("confirmed_slot")
  landlordNote   String?             @map("landlord_note")
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  // The schema doc's idx_visit_expiry is a PARTIAL index (WHERE status =
  // 'pending'), which Prisma's schema DSL can't express — plain index on
  // the same column instead; the worker's expiry sweep still filters on
  // status in its WHERE clause, so correctness doesn't depend on this.
  @@index([landlordId, status])
  @@index([expiresAt])
  @@map("visit_requests")
}

// ============================================================
// B.4 — Tenancy & Occupancy Module
// ============================================================

enum TenancyStatus {
  active
  notice_given
  terminated
  expired
}

enum NoticeReason {
  non_payment
  end_of_term
  other
}

model Tenancy {
  id                        String        @id @default(uuid())
  unitId                    String        @map("unit_id") // references units.id — NOT a Prisma
                                                             // relation across modules, per CLAUDE.md.
  tenantId                  String        @map("tenant_id") // references users.id — same rule.
  landlordId                String        @map("landlord_id") // same rule.
  startDate                 DateTime      @map("start_date") @db.Date
  rentAmount                Decimal       @db.Decimal(12, 0) @map("rent_amount")
  currency                  String        @default("XAF")
  billingCycle               String       @default("monthly") @map("billing_cycle")
  noticePeriodDays           Int          @default(90) @map("notice_period_days")
  maxAdvanceMonths           Int          @default(3) @map("max_advance_months")
  // Denormalized cache written ONLY by the Payments module's payment.confirmed
  // handler (once that module exists) — never written directly here. Ledger
  // stays authoritative; this just lets the reminder scheduler avoid
  // aggregating the ledger on every run. See schema doc B.4.
  paidThroughDate             DateTime?    @map("paid_through_date") @db.Date
  reminderFirstDaysBefore     Int          @default(30) @map("reminder_first_days_before")
  reminderSecondDaysBefore    Int          @default(14) @map("reminder_second_days_before")
  status                      TenancyStatus @default(active)
  createdAt                   DateTime     @default(now()) @map("created_at")
  updatedAt                   DateTime     @updatedAt @map("updated_at")

  terminationNotices TerminationNotice[]

  @@index([landlordId, status])
  @@index([tenantId, status])
  // idx_tenancies_paid_through in the schema doc is a PARTIAL index
  // (WHERE status = 'active') — same limitation as visit_requests'
  // idx_visit_expiry; plain index instead, callers still filter explicitly.
  @@index([paidThroughDate])
  @@map("tenancies")
}

model TerminationNotice {
  id                  String        @id @default(uuid())
  tenancyId           String        @map("tenancy_id")
  issuedBy             String       @map("issued_by") // references users.id — must be the landlord.
  reason                NoticeReason?
  reasonDetail          String?      @map("reason_detail")
  issuedAt               DateTime    @default(now()) @map("issued_at")
  effectiveDate           DateTime   @map("effective_date") @db.Date
  documentUrl              String?   @map("document_url")
  deliveryChannel           String?  @map("delivery_channel") // 'sms' | 'app' | 'both'
  deliveryConfirmedAt        DateTime? @map("delivery_confirmed_at")
  createdAt                   DateTime @default(now()) @map("created_at")

  tenancy Tenancy @relation(fields: [tenancyId], references: [id])

  @@map("termination_notices")
}

// ============================================================
// B.5 — Payments & Ledger Module
// ============================================================

enum PaymentProvider {
  campay
  monetbil
}

enum PaymentStatus {
  pending
  confirmed
  failed
  reconciling
}

enum LedgerEntryType {
  debit
  credit
}

model Payment {
  id              String          @id @default(uuid())
  tenancyId       String          @map("tenancy_id") // references tenancies.id — NOT a Prisma
                                                        // relation across modules, per CLAUDE.md.
  tenantId        String          @map("tenant_id") // references users.id — same rule.
  amount          Decimal         @db.Decimal(12, 0)
  currency        String          @default("XAF")
  periodStart     DateTime        @map("period_start") @db.Date
  periodEnd       DateTime        @map("period_end") @db.Date
  provider        PaymentProvider
  providerTxnRef  String?         @map("provider_txn_ref")
  idempotencyKey  String          @unique @map("idempotency_key")
  status          PaymentStatus   @default(pending)
  initiatedAt     DateTime        @default(now()) @map("initiated_at")
  confirmedAt     DateTime?       @map("confirmed_at")
  failureReason   String?         @map("failure_reason")
  receiptUrl      String?         @map("receipt_url")

  ledgerEntries LedgerEntry[]

  @@index([tenancyId, status])
  // idx_payments_pending_recon in the schema doc is a PARTIAL index (WHERE
  // status = 'pending') — same limitation noted on visit_requests/tenancies;
  // the reconciliation sweep still filters on status explicitly.
  @@index([status, initiatedAt])
  @@map("payments")
}

// Append-only — never UPDATE or DELETE a row in application code, even for
// corrections (those are new offsetting rows). CLAUDE.md hard rule.
model LedgerEntry {
  id             String          @id @default(uuid())
  tenancyId      String          @map("tenancy_id")
  paymentId      String?         @map("payment_id")
  entryType      LedgerEntryType @map("entry_type")
  amount         Decimal         @db.Decimal(12, 0)
  runningBalance Decimal         @map("running_balance") @db.Decimal(12, 0)
  description    String?
  createdAt      DateTime        @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([tenancyId, createdAt])
  @@map("ledger_entries")
}

model PaymentWebhookRaw {
  id                 String    @id @default(uuid())
  provider           String
  payload            Json
  signatureVerified  Boolean   @map("signature_verified")
  receivedAt         DateTime  @default(now()) @map("received_at")
  processedAt        DateTime? @map("processed_at")

  @@map("payment_webhooks_raw")
}

