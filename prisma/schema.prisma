// This schema is seeded with the Auth (B.1) and Property/Listings (B.2) modules fully
// modeled, matching the SQL DDL in docs/deployment-infrastructure-and-module-schemas.md
// EXACTLY (field names, types, constraints). Extend it module-by-module in the build
// order specified in CLAUDE.md — copy this pattern (add the model, add the enum if
// needed, run `npm run prisma:migrate`) rather than inventing a different structure.
//
// IMPORTANT: field names here must match the DDL in the docs verbatim. If you need to
// deviate, update the docs first — they are the source of truth, not this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// B.1 — Auth & Identity Module
// ============================================================

enum KycTier {
  unverified
  id_verified
  ownership_verified
}

enum UserRole {
  landlord
  tenant
  admin
  support_agent
}

model User {
  id               String    @id @default(uuid())
  phoneNumber      String    @unique @map("phone_number")
  fullName         String?   @map("full_name")
  locale           String    @default("fr") // 'fr' | 'en'
  idDocumentType   String?   @map("id_document_type")
  idDocumentRef    String?   @map("id_document_ref")
  idDocumentUrl    String?   @map("id_document_url")
  kycTier          KycTier   @default(unverified) @map("kyc_tier")
  kycVerifiedAt    DateTime? @map("kyc_verified_at")
  kycVerifiedBy    String?   @map("kyc_verified_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deactivatedAt    DateTime? @map("deactivated_at")

  roles            UserRoleAssignment[]
  sessions         Session[]

  @@map("users")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      UserRole
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model OtpChallenge {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number")
  otpHash     String    @map("otp_hash")
  purpose     String    // 'login' | 'signup' | 'sensitive_action'
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@map("otp_challenges")
}

model Session {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  refreshTokenHash  String    @map("refresh_token_hash")
  deviceInfo        Json?     @map("device_info")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// B.2 — Property & Listings Module
// ============================================================

// Not in the original schema doc's DDL — added after live stakeholder-demo
// feedback (2026-09-18) asking for richer property/unit detail than
// address+city+rent. "general" from that feedback is modeled as
// `mixed_use` (residential+commercial in the same property); both fields
// are optional so every property created before this migration stays valid.
enum PropertyType {
  residential
  commercial
  mixed_use
}

model Property {
  id                     String       @id @default(uuid())
  landlordId             String       @map("landlord_id") // references users.id — NOT a Prisma relation
                                                          // across modules, per the cross-module rule in
                                                          // CLAUDE.md. Look up landlord details via the
                                                          // Auth module's service, not a Prisma join.
  name                   String?
  propertyType           PropertyType? @map("property_type")
  // Freeform tags, not a normalized table — no admin UI exists to curate a
  // fixed facility list yet (same "dead schema with no writer" reasoning
  // CLAUDE.md already applies to notification_templates/contract_signatures).
  // e.g. "gated", "generator", "borehole", "security_personnel".
  facilities             String[]     @default([])
  addressLine            String       @map("address_line")
  city                   String
  region                 String?
  latitude               Decimal?     @db.Decimal(9, 6)
  longitude              Decimal?     @db.Decimal(9, 6)
  ownershipDocUrl        String?      @map("ownership_doc_url")
  ownershipVerifiedAt    DateTime?    @map("ownership_verified_at")
  ownershipVerifiedBy    String?      @map("ownership_verified_by")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  units Unit[]

  @@map("properties")
}

enum UnitStatus {
  draft
  vacant
  visit_requested
  reserved
  occupied
  notice_given
}

enum BillingCycle {
  monthly
  quarterly
  biannual
}

model Unit {
  id           String       @id @default(uuid())
  propertyId   String       @map("property_id")
  label        String?
  bedrooms     Int?
  bathrooms    Int?
  // Same freeform-tags reasoning as Property.facilities — e.g. "ac", "wifi",
  // "hot_water", "furnished". Added 2026-09-18 after live demo feedback.
  facilities   String[]     @default([])
  sizeSqm      Decimal?     @db.Decimal(8, 2) @map("size_sqm")
  rentAmount   Decimal      @db.Decimal(12, 0) @map("rent_amount")
  currency     String       @default("XAF")
  billingCycle BillingCycle @default(monthly) @map("billing_cycle")
  status       UnitStatus   @default(draft)
  description  String?
  // Current moderation state (added 2026-09-24, Admin module) — set only by
  // an admin action, never by the landlord (not on UpdateUnitDto). While
  // flagged, the unit is excluded from public search/detail regardless of
  // `status`. Non-null values pair with `admin_actions_log` rows recording
  // the same action for durable history; these columns are just "is this
  // currently flagged", not the audit trail itself.
  flaggedAt    DateTime?    @map("flagged_at")
  flagReason   String?      @map("flag_reason")
  flaggedBy    String?      @map("flagged_by") // references users.id — not a Prisma relation, per CLAUDE.md
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  photos   UnitPhoto[]

  @@index([status])
  @@index([propertyId])
  @@index([flaggedAt])
  @@map("units")
}

model UnitPhoto {
  id           String    @id @default(uuid())
  unitId       String    @map("unit_id")
  storageUrl   String    @map("storage_url")
  geoLatitude  Decimal?  @db.Decimal(9, 6) @map("geo_latitude")
  geoLongitude Decimal?  @db.Decimal(9, 6) @map("geo_longitude")
  capturedAt   DateTime? @map("captured_at")
  sortOrder    Int       @default(0) @map("sort_order")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_photos")
}

// Audit trail of landlord edits to properties and units (added 2026-09-20,
// demo feedback: landlords can now edit everything about their listings, and
// the platform must be able to tell when details were changed — especially
// after a tenant already moved in). APPEND-ONLY, same spirit as
// ledger_entries: application code only ever INSERTs into this table, never
// UPDATEs or DELETEs, so it stays trustworthy as evidence.
enum ListingEntityType {
  property
  unit
}

model ListingChange {
  id           String            @id @default(uuid())
  entityType   ListingEntityType @map("entity_type")
  // Always set — a unit change records its property too, so "everything that
  // happened at this property" is one query.
  propertyId   String            @map("property_id")
  unitId       String?           @map("unit_id")
  // Name/label at the moment of the change, since either can be edited later.
  entityLabel  String?           @map("entity_label")
  changedBy    String            @map("changed_by") // references users.id — NOT a Prisma relation.
  // 'updated' | 'photo_added' | 'photo_removed' | 'cover_photo_changed'
  action       String
  // [{ field, from, to }] — only the fields that actually changed.
  changes      Json
  note         String?
  // Units, among those this change touched, that had a tenant in residence
  // (status occupied or notice_given) when it was made. Non-empty means "the
  // landlord changed this while someone was living there".
  occupiedUnitIds          String[]  @default([]) @map("occupied_unit_ids")
  // Whether the property carried the ownership-verified badge at the time — a
  // change to a verified property's address is what an admin re-checks.
  propertyVerifiedAtChange Boolean   @map("property_verified_at_change")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([propertyId, createdAt])
  @@index([unitId, createdAt])
  @@index([changedBy, createdAt])
  @@index([createdAt])
  @@map("listing_changes")
}

// ============================================================
// B.3 — Visit Requests Module
// ============================================================

enum VisitRequestStatus {
  pending
  accepted
  declined
  rescheduled
  expired
  completed
}

model VisitRequest {
  id             String              @id @default(uuid())
  unitId         String              @map("unit_id") // references units.id — NOT a Prisma relation
                                                        // across modules, per CLAUDE.md. Look up the unit
                                                        // via the Properties module's service.
  tenantId       String              @map("tenant_id") // references users.id — same rule.
  landlordId     String              @map("landlord_id") // denormalized for fast landlord-side queries.
  requestedSlots Json?               @map("requested_slots")
  status         VisitRequestStatus  @default(pending)
  confirmedSlot  DateTime?           @map("confirmed_slot")
  landlordNote   String?             @map("landlord_note")
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  // The schema doc's idx_visit_expiry is a PARTIAL index (WHERE status =
  // 'pending'), which Prisma's schema DSL can't express — plain index on
  // the same column instead; the worker's expiry sweep still filters on
  // status in its WHERE clause, so correctness doesn't depend on this.
  @@index([landlordId, status])
  @@index([expiresAt])
  @@map("visit_requests")
}

// Not in the original schema doc's B.3 DDL — added 2026-09-18 after
// stakeholder-demo feedback: a tenant browsing units needs a lighter-weight
// signal than "request a visit" (no scheduling involved), and the landlord
// needs a one-click path from "someone is interested" straight to creating
// a tenancy, as an alternative to the existing paste-the-tenant-id form.
// Lives alongside VisitRequest rather than as a new bounded module — same
// "tenant signal on a unit, before a tenancy exists" domain, same
// denormalized-landlordId-for-inbox-queries pattern.
enum UnitInterestStatus {
  pending
  converted
}

model UnitInterest {
  id         String             @id @default(uuid())
  unitId     String             @map("unit_id") // references units.id — NOT a Prisma relation
                                                    // across modules, per CLAUDE.md.
  tenantId   String             @map("tenant_id") // references users.id — same rule.
  landlordId String             @map("landlord_id") // denormalized for fast landlord-side queries.
  status     UnitInterestStatus @default(pending)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  // One open interest per tenant per unit — expressing interest again on
  // the same unit is idempotent (see VisitsService.expressInterest), not a
  // new row every click.
  @@unique([unitId, tenantId])
  @@index([landlordId, status])
  @@map("unit_interests")
}

// ============================================================
// B.4 — Tenancy & Occupancy Module
// ============================================================

enum TenancyStatus {
  active
  notice_given
  terminated
  expired
}

enum NoticeReason {
  non_payment
  end_of_term
  other
}

model Tenancy {
  id                        String        @id @default(uuid())
  unitId                    String        @map("unit_id") // references units.id — NOT a Prisma
                                                             // relation across modules, per CLAUDE.md.
  tenantId                  String        @map("tenant_id") // references users.id — same rule.
  landlordId                String        @map("landlord_id") // same rule.
  startDate                 DateTime      @map("start_date") @db.Date
  rentAmount                Decimal       @db.Decimal(12, 0) @map("rent_amount")
  currency                  String        @default("XAF")
  billingCycle               String       @default("monthly") @map("billing_cycle")
  noticePeriodDays           Int          @default(90) @map("notice_period_days")
  maxAdvanceMonths           Int          @default(3) @map("max_advance_months")
  // Denormalized cache written ONLY by the Payments module's payment.confirmed
  // handler (once that module exists) — never written directly here. Ledger
  // stays authoritative; this just lets the reminder scheduler avoid
  // aggregating the ledger on every run. See schema doc B.4.
  paidThroughDate             DateTime?    @map("paid_through_date") @db.Date
  reminderFirstDaysBefore     Int          @default(30) @map("reminder_first_days_before")
  reminderSecondDaysBefore    Int          @default(14) @map("reminder_second_days_before")
  status                      TenancyStatus @default(active)
  createdAt                   DateTime     @default(now()) @map("created_at")
  updatedAt                   DateTime     @updatedAt @map("updated_at")

  terminationNotices TerminationNotice[]

  @@index([landlordId, status])
  @@index([tenantId, status])
  // idx_tenancies_paid_through in the schema doc is a PARTIAL index
  // (WHERE status = 'active') — same limitation as visit_requests'
  // idx_visit_expiry; plain index instead, callers still filter explicitly.
  @@index([paidThroughDate])
  @@map("tenancies")
}

model TerminationNotice {
  id                  String        @id @default(uuid())
  tenancyId           String        @map("tenancy_id")
  issuedBy             String       @map("issued_by") // references users.id — must be the landlord.
  reason                NoticeReason?
  reasonDetail          String?      @map("reason_detail")
  issuedAt               DateTime    @default(now()) @map("issued_at")
  effectiveDate           DateTime   @map("effective_date") @db.Date
  documentUrl              String?   @map("document_url")
  deliveryChannel           String?  @map("delivery_channel") // 'sms' | 'app' | 'both'
  deliveryConfirmedAt        DateTime? @map("delivery_confirmed_at")
  createdAt                   DateTime @default(now()) @map("created_at")

  tenancy Tenancy @relation(fields: [tenancyId], references: [id])

  @@map("termination_notices")
}

// ============================================================
// B.5 — Payments & Ledger Module
// ============================================================

enum PaymentProvider {
  campay
  monetbil
  // Rent the landlord records as already received outside the platform (e.g.
  // cash paid upfront when the tenancy is created) — added 2026-09-20. Never
  // accepted from the client-facing API (CreatePaymentDto still only allows
  // 'campay' | 'monetbil'); only PaymentsService.recordPrepaidRent writes it,
  // so a tenant can't mark their own rent as paid.
  offline
}

enum PaymentStatus {
  pending
  confirmed
  failed
  reconciling
}

enum LedgerEntryType {
  debit
  credit
}

model Payment {
  id              String          @id @default(uuid())
  tenancyId       String          @map("tenancy_id") // references tenancies.id — NOT a Prisma
                                                        // relation across modules, per CLAUDE.md.
  tenantId        String          @map("tenant_id") // references users.id — same rule.
  amount          Decimal         @db.Decimal(12, 0)
  currency        String          @default("XAF")
  periodStart     DateTime        @map("period_start") @db.Date
  periodEnd       DateTime        @map("period_end") @db.Date
  provider        PaymentProvider
  providerTxnRef  String?         @map("provider_txn_ref")
  idempotencyKey  String          @unique @map("idempotency_key")
  status          PaymentStatus   @default(pending)
  initiatedAt     DateTime        @default(now()) @map("initiated_at")
  confirmedAt     DateTime?       @map("confirmed_at")
  failureReason   String?         @map("failure_reason")
  receiptUrl      String?         @map("receipt_url")

  ledgerEntries LedgerEntry[]

  @@index([tenancyId, status])
  // idx_payments_pending_recon in the schema doc is a PARTIAL index (WHERE
  // status = 'pending') — same limitation noted on visit_requests/tenancies;
  // the reconciliation sweep still filters on status explicitly.
  @@index([status, initiatedAt])
  @@map("payments")
}

// Append-only — never UPDATE or DELETE a row in application code, even for
// corrections (those are new offsetting rows). CLAUDE.md hard rule.
model LedgerEntry {
  id             String          @id @default(uuid())
  tenancyId      String          @map("tenancy_id")
  paymentId      String?         @map("payment_id")
  entryType      LedgerEntryType @map("entry_type")
  amount         Decimal         @db.Decimal(12, 0)
  runningBalance Decimal         @map("running_balance") @db.Decimal(12, 0)
  description    String?
  createdAt      DateTime        @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([tenancyId, createdAt])
  @@map("ledger_entries")
}

model PaymentWebhookRaw {
  id                 String    @id @default(uuid())
  provider           String
  payload            Json
  signatureVerified  Boolean   @map("signature_verified")
  receivedAt         DateTime  @default(now()) @map("received_at")
  processedAt        DateTime? @map("processed_at")

  @@map("payment_webhooks_raw")
}

// ============================================================
// B.6 — Contract Generation & e-Signature Module
// ============================================================

enum ContractStatus {
  draft
  pending_signatures
  fully_signed
  voided
}

// contract_signatures from the schema doc's B.6 DDL is deliberately NOT
// modeled here: e-signature (Epic 6 AC2/AC3, POST /contracts/{id}/sign) is
// deferred pending the "basic vs. advanced tier" legal question flagged in
// CLAUDE.md — see the Resolved decisions entry (2026-09-17). A signatures
// table with no code path that ever writes to it would just be dead
// schema; add it when that flow is actually built. A contract created
// today therefore stays `draft` forever — there's no transition to
// `pending_signatures`/`fully_signed` yet.
model Contract {
  id              String         @id @default(uuid())
  tenancyId       String         @map("tenancy_id") // references tenancies.id — NOT a Prisma
                                                        // relation across modules, per CLAUDE.md.
  templateVersion String         @map("template_version")
  locale          String // 'fr' | 'en'
  documentUrl     String         @map("document_url")
  status          ContractStatus @default(draft)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([tenancyId])
  @@map("contracts")
}

// ============================================================
// B.7 — Notification Engine Module (multi-channel version;
// docs/notification-module-multichannel.md Section 3 is the source of
// truth here, superseding the single-channel schema in the main
// deployment doc, per CLAUDE.md).
// ============================================================

enum NotificationChannelType {
  sms
  whatsapp
  email
  push
  in_app
}

enum NotificationStatus {
  queued
  sent
  delivered
  read
  failed
  skipped
}

enum PushPlatform {
  android
  ios
}

// notification_templates from the multichannel doc's DDL is deliberately
// NOT modeled here: there's no admin UI to manage templates yet (Admin is
// build order #9), so a DB table of template rows would just be seed data
// nothing ever edits — the same "dead schema with no writer" reasoning as
// skipping contract_signatures. Templates are hardcoded bilingual render
// functions per event type instead (notification-content.ts), mirroring
// contract-document.ts/notice-document.ts/receipt-document.ts. Revisit if
// Admin ever needs to manage these directly. `notifications.template_id`
// is dropped for the same reason — event_type + channel already identify
// what was sent.
model Notification {
  id                     String               @id @default(uuid())
  userId                 String               @map("user_id") // references users.id — NOT a Prisma
                                                                   // relation across modules, per CLAUDE.md.
  eventType              String               @map("event_type")
  channel                NotificationChannelType
  payload                Json?
  status                 NotificationStatus   @default(queued)
  skipReason             String?              @map("skip_reason")
  provider               String?
  providerMessageId      String?              @map("provider_message_id")
  whatsappCategoryBilled String?              @map("whatsapp_category_billed")
  estimatedCostXaf       Decimal?             @db.Decimal(8, 2) @map("estimated_cost_xaf")
  scheduledFor           DateTime?            @map("scheduled_for")
  sentAt                 DateTime?            @map("sent_at")
  deliveredAt            DateTime?            @map("delivered_at")
  readAt                 DateTime?            @map("read_at")
  createdAt              DateTime             @default(now()) @map("created_at")

  // idx_notifications_scheduled/idx_notifications_cost_audit from the doc
  // are PARTIAL indexes (WHERE status = 'queued' / WHERE channel =
  // 'whatsapp') — same limitation noted elsewhere on partial indexes not
  // expressible in Prisma; callers still filter explicitly.
  @@index([userId, readAt])
  @@index([scheduledFor])
  @@index([channel, createdAt])
  @@map("notifications")
}

// Per-user, per-channel opt-in state for the channels that need explicit
// consent/identifier capture (sms/whatsapp/email). Push is tracked via
// PushDeviceToken instead (the token itself is both identifier and proof
// of reachability); in_app needs no opt-in row — it's the unconditional
// fallback channel, per the doc's own channel list for this table
// excluding 'in_app'.
model NotificationChannel {
  id               String                   @id @default(uuid())
  userId           String                   @map("user_id")
  channel          NotificationChannelType
  channelIdentifier String                  @map("channel_identifier")
  optedIn          Boolean                  @default(false) @map("opted_in")
  optedInAt        DateTime?                @map("opted_in_at")
  optedOutAt       DateTime?                @map("opted_out_at")
  verified         Boolean                  @default(false)
  lastKnownGoodAt  DateTime?                @map("last_known_good_at")
  createdAt        DateTime                 @default(now()) @map("created_at")

  @@unique([userId, channel])
  @@map("notification_channels")
}

model PushDeviceToken {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  fcmToken   String       @unique @map("fcm_token")
  platform   PushPlatform
  lastSeenAt DateTime     @default(now()) @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_device_tokens")
}

// `rent_reminder_days_before` from the multichannel doc's DDL is
// deliberately omitted: it's a leftover from the original single-channel
// design (a single per-user reminder offset). Tenancies already owns the
// real, already-implemented, landlord-configurable version of this
// setting — two PER-TENANCY fields (`reminder_first_days_before`/
// `reminder_second_days_before`, see Tenancy model above), which is what
// the rent-expiry scan actually reads (schema doc B.7's pseudocode).
// A second, disconnected per-user field here would never be read by
// anything — dead data, not "matching the DDL for its own sake."
model NotificationPreference {
  userId               String  @id @map("user_id")
  preferredChannelOrder String @default("push,whatsapp,sms,email") @map("preferred_channel_order")
  smsEnabled           Boolean @default(true) @map("sms_enabled")
  whatsappEnabled      Boolean @default(false) @map("whatsapp_enabled")
  emailEnabled         Boolean @default(true) @map("email_enabled")
  pushEnabled          Boolean @default(true) @map("push_enabled")

  @@map("notification_preferences")
}

// ============================================================
// B.8 — Complaints & Maintenance Module
// ============================================================

enum ComplaintCategory {
  plumbing
  electrical
  security
  noise
  other
}

enum ComplaintStatus {
  open
  acknowledged
  in_progress
  resolved
  closed
}

enum ComplaintMediaType {
  photo
  video
}

model Complaint {
  id          String            @id @default(uuid())
  tenancyId   String            @map("tenancy_id") // references tenancies.id — NOT a Prisma
                                                       // relation across modules, per CLAUDE.md.
  unitId      String            @map("unit_id") // denormalized for the landlord's per-unit
                                                    // aggregate view (PRD Epic 7 US-7.2) — same rule.
  tenantId    String            @map("tenant_id") // references users.id — same rule.
  landlordId  String            @map("landlord_id") // same rule.
  category    ComplaintCategory
  description String
  status      ComplaintStatus   @default(open)
  createdAt   DateTime          @default(now()) @map("created_at")
  acknowledgedAt DateTime?      @map("acknowledged_at")
  resolvedAt     DateTime?      @map("resolved_at")

  media   ComplaintMedia[]
  updates ComplaintUpdate[]

  @@index([landlordId, status])
  @@index([unitId])
  @@map("complaints")
}

model ComplaintMedia {
  id          String             @id @default(uuid())
  complaintId String             @map("complaint_id")
  storageUrl  String             @map("storage_url")
  mediaType   ComplaintMediaType @map("media_type")
  uploadedAt  DateTime           @default(now()) @map("uploaded_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_media")
}

// Audit trail of every status change (and any freeform landlord note),
// per PRD Epic 7 US-7.1 AC2's "tenant sees status updates" — this is what
// GET /landlords/me/complaints and the tenant-facing history are built on.
model ComplaintUpdate {
  id          String           @id @default(uuid())
  complaintId String           @map("complaint_id")
  authorId    String           @map("author_id") // references users.id — the landlord who made the change.
  note        String?
  newStatus   ComplaintStatus? @map("new_status")
  createdAt   DateTime         @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_updates")
}

// ============================================================
// B.9 — Admin / Ops Module
// ============================================================

// The only table Admin owns outright (per the schema doc's B.9: "mostly a
// read/action layer over other modules"). Every state-changing admin action
// writes one row here — either directly (the Admin module's own endpoints,
// e.g. flagging/removing a listing) or via an @OnEvent listener reacting to
// an action another module's own endpoint triggered (e.g. Auth's existing
// POST /admin/users/{id}/kyc/approve, via user.kyc_tier_changed) — so this
// stays a pure audit trail, never a bypass around another module's own API,
// per CLAUDE.md's cross-module rule.
model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id") // references users.id — not a Prisma relation
  actionType String   @map("action_type") // 'kyc_approved' | 'listing_flagged' | 'listing_unflagged' | 'listing_removed'
  targetType String   @map("target_type") // 'user' | 'unit'
  targetId   String   @map("target_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("admin_actions_log")
}

